#!/usr/bin/env bash
set -euo pipefail

# Reports only Secret names and their Pod-spec reference points.

if [[ $# -ne 4 ]]; then
  echo "Usage: k9s-pod-secret-references <name> <namespace> <kubeconfig> <context>" >&2
  exit 2
fi

pod_name="$1"
namespace="$2"
kubeconfig="$3"
context="$4"

python3 - "$pod_name" "$namespace" "$kubeconfig" "$context" <<'PY'
import json
import subprocess
import sys

pod_name, namespace, kubeconfig, context = sys.argv[1:]
pod = json.loads(subprocess.check_output([
    "kubectl", "get", "pod", pod_name,
    "--namespace", namespace,
    "--kubeconfig", kubeconfig,
    "--context", context,
    "-o", "json",
], text=True))

references = []

def add(secret_name, reference_type):
    if secret_name:
        references.append((secret_name, reference_type))

spec = pod.get("spec", {})
for image_pull_secret in spec.get("imagePullSecrets", []):
    add(image_pull_secret.get("name"), "imagePullSecret")

for container_group in ("initContainers", "containers", "ephemeralContainers"):
    for container in spec.get(container_group, []):
        container_name = container.get("name", "unknown")
        for env_from in container.get("envFrom", []):
            add(env_from.get("secretRef", {}).get("name"), f"{container_group}/{container_name}: envFrom")
        for env in container.get("env", []):
            secret_ref = env.get("valueFrom", {}).get("secretKeyRef", {})
            if secret_ref:
                add(secret_ref.get("name"), f"{container_group}/{container_name}: env/{env.get('name', 'unknown')}")

for volume in spec.get("volumes", []):
    volume_name = volume.get("name", "unknown")
    add(volume.get("secret", {}).get("secretName"), f"volume/{volume_name}: secret")
    for source in volume.get("projected", {}).get("sources", []):
        add(source.get("secret", {}).get("name"), f"volume/{volume_name}: projected secret")
    add(volume.get("csi", {}).get("nodePublishSecretRef", {}).get("name"), f"volume/{volume_name}: CSI")
    add(volume.get("azureFile", {}).get("secretName"), f"volume/{volume_name}: azureFile")
    add(volume.get("cephfs", {}).get("secretRef", {}).get("name"), f"volume/{volume_name}: cephfs")
    add(volume.get("cinder", {}).get("secretRef", {}).get("name"), f"volume/{volume_name}: cinder")
    add(volume.get("flexVolume", {}).get("secretRef", {}).get("name"), f"volume/{volume_name}: flexVolume")

unique_references = sorted(set(references), key=lambda item: (item[0], item[1]))
print(f"Secret references for Pod {namespace}/{pod_name}:")
if not unique_references:
    print("  None found in Pod spec.")
    sys.exit(0)

for secret_name, reference_type in unique_references:
    print(f"  {secret_name}  ({reference_type})")

print("\nNames only; Secret data is never read. Open :secrets then filter by a listed name.")
PY
