#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 4 ]]; then
  echo "Usage: k9s-copy-workload-image <pod-name> <namespace> <kubeconfig> <context>" >&2
  exit 2
fi

pod_name="$1"
namespace="$2"
kubeconfig="$3"
context="$4"

images=$(kubectl get pod "$pod_name" --namespace "$namespace" --kubeconfig "$kubeconfig" --context "$context" -o jsonpath='{range .spec.containers[*]}{.image}{"\n"}{end}')
if [[ -z "$images" ]]; then
  echo "No container images found on Pod '$namespace/$pod_name'." >&2
  exit 1
fi

if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$images" | pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
  printf '%s' "$images" | wl-copy
elif command -v xclip >/dev/null 2>&1; then
  printf '%s' "$images" | xclip -selection clipboard
else
  printf '%s\n' "$images"
  echo "No supported clipboard command found (tried pbcopy, wl-copy, and xclip)." >&2
  exit 1
fi
